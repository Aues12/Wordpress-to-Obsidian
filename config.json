{
  "wordpress": {
    "base_url": "https://your-site.com"
  },
  "paths": {
    "json_file": "data/imported.json",
    "output_dir": "output"
  },
  "frontmatter": {
    "include_frontmatter": false,
    "fields": [
      "title",
      "date",
      "modified",
      "slug",
      "category_names"
    ]
  },
  "usage_profile": {
    "refresh": true,
    "order": "newest",
    "limit": 10,
    "write_order": "newest",
    "mode": "per_post",
    "include_frontmatter": true,
    "format": "md",
    "output_dir": "output"
  }
}